[default]
# Device for running models: auto, cpu, cuda, mps, or cuda:N
model_device = "auto"

[server]
# Server host and port settings
host = "127.0.0.1"
port = 8000
reload = true

[logging]
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
level = "INFO"

# ============================================================================
# COLLECTION CONFIGURATIONS
# Add a `[[collections]]` table for each collection, with one or more nested
# `[[collections.indexes]]` tables. Set enabled = true to activate it.
# ============================================================================

# Zarr collection -- embeddings_file is used directly as the brute-force index:
[[collections]]
name = "collection1"
enabled = true

# --- Required ---
database_file = "./data/collection1/collection1.db"
thumbnail_media_url = "https://localhost:5001/collection1"
original_media_url = "https://localhost:5001/collection1"

# --- Optional: Logging ---
# log_directory = "./logs/collection1/"

# --- Optional: Startup loading ---
# By default only the default index's model, embeddings, and ANN structure
# load at startup; every other index's model/embeddings/ANN structure loads
# lazily the first time it's actually used. Set this to true to eagerly
# load all of that, for every index, at startup instead.
# preload_all_indexes = false

  # A collection with more than one index must mark exactly one as
  # default = true -- that's the index used when a request doesn't pick one.
  [[collections.indexes]]
  name = "CLIP"
  index_type = "zarr"
  embeddings_file = "./data/collection1/embeddings.zipstore"
  default = true

  [[collections.indexes]]
  name = "Text"
  index_type = "zarr"
  embeddings_file = "./data/collection1/embeddings.zarr"
  embedding_type = "Text"
  model_name = "your-sentence-transformers-model"

# FAISS collection -- separate ANN index and raw embeddings required. A
# collection can declare more than one index (e.g. a second index over a
# different embedding space, such as text transcripts) by adding another
# `[[collections.indexes]]` table with its own unique `name`.
# [[collections]]
# name = "collection2"
# enabled = true
# database_file = "./data/collection2/collection2.db"
# thumbnail_media_url = "https://localhost:5001/collection2"
# original_media_url = "https://localhost:5001/collection2"
# log_directory = "./logs/collection2/"
#
#   [[collections.indexes]]
#   name = "CLIP"
#   index_type = "faiss"
#   index_file = "./data/collection2/clip_index.faiss"
#   embeddings_file = "./data/collection2/embeddings.zip"
