[default]
# Device for running models: auto, cpu, cuda, mps, or cuda:N
model_device = "auto"

[server]
# Server host and port settings
host = "127.0.0.1"
port = 8000
reload = true

[logging]
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
level = "INFO"

# ============================================================================
# COLLECTION CONFIGURATIONS
# Add a `[[collections]]` table for each collection, with one or more nested
# `[[collections.indexes]]` tables. Set enabled = true to activate it.
#
# Each index picks its own `index_type` independently, "zarr" (the raw
# embeddings file doubles as a brute-force index, no `index_file` needed)
# or "faiss" (a separate ANN `index_file` alongside the embeddings). A
# single collection can freely mix index types; nothing below ties a
# collection as a whole to one backend.
# ============================================================================

[[collections]]
name = "collection1"
enabled = true

# --- Required ---
database_file = "./data/collection1/collection1.db"
thumbnail_media_url = "https://localhost:5001/collection1"
original_media_url = "https://localhost:5001/collection1"

# --- Optional: Logging ---
# log_directory = "./logs/collection1/"

# --- Optional: Startup loading ---
# By default only the default index's model, embeddings, and ANN structure
# load at startup; every other index's model/embeddings/ANN structure loads
# lazily the first time it's actually used. Set this to true to eagerly
# load all of that, for every index, at startup instead.
# preload_all_indexes = false

  # A collection with more than one index must mark exactly one as
  # default = true, which will be the index used when a request doesn't pick one.
  # No `tagset` is set here, so this index reads its item-to-position
  # mapping from the default tagset name, "CLIP_hnsw Index ID".
  [[collections.indexes]]
  name = "CLIP_hnsw"
  index_type = "faiss"
  index_file = "./data/collection1/clip_hnsw.faiss"
  embeddings_file = "./data/collection1/clip_embeddings.zipstore"
  default = true

  # A different embedding space entirely (e.g. text transcripts) is just
  # another index in the same collection, with its own embedding_type,
  # model, source_type, and its own index_type, "zarr" here, since
  # each index picks its backend independently. source_type tells the
  # database which kind of media this index maps to ("Image", "Video",
  # "Audio", "Text", or "Other"); defaults to "Image".
  [[collections.indexes]]
  name = "Transcripts"
  index_type = "zarr"
  embeddings_file = "./data/collection1/transcript_embeddings.zarr"
  embedding_type = "Text"
  model_name = "your-sentence-transformers-model"
  source_type = "Text"

# A second collection, showing two ANN structures over the *same*
# embedding space, built from the same vectors, in the same insertion
# order, e.g. an HNSW graph for fast approximate search and an IVF+PQ
# index for a smaller memory footprint. Both set `tagset` to the same
# name, "SigLIP ID", so they share one item-to-position mapping instead of
# each getting its own duplicate one. `tagset` is used verbatim, so
# it doesn't have to follow the "<name> Index ID" convention at all.
